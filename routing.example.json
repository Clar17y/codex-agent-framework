{
  "version": 6,
  "providers": {
    "gemini": {
      "executable": "agy",
      "model": "gemini-3.8-flash-medium",
      "timeout_seconds": 1800,
      "termination_grace_seconds": 120,
      "heartbeat_seconds": 60
    },
    "deepseek": {
      "executable": "codex",
      "profile": "deepseek",
      "model": "deepseek-flash",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "claude": {
      "executable": "claude",
      "model": "claude-opus-5",
      "effort": "medium"
    }
  },
  "timeout_seconds": 900,
  "quota_probe_seconds": 3600,
  "lock_timeout_seconds": 30
}
