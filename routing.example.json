{
  "version": 12,
  "workflow": {
    "require_jev_evidence": true
  },
  "providers": {
    "gemini": {
      "executable": "agy",
      "model": "gemini-3.8-flash-medium",
      "timeout_seconds": 3600,
      "termination_grace_seconds": 120,
      "heartbeat_seconds": 60,
      "reader_agent": "framework-reader",
      "reader_agent_file": "~/.gemini/config/agents/framework-reader.md"
    },
    "claude": {
      "executable": "claude",
      "model": "claude-opus-5-5",
      "effort": "medium",
      "heartbeat_seconds": 60
    },
    "muse": {
      "executable": "muse",
      "model": "muse-wonder-1.0",
      "effort": "medium",
      "timeout_seconds": 3600,
      "termination_grace_seconds": 120,
      "heartbeat_seconds": 60,
      "max_model_steps": 100,
      "profiles": {
        "complex": {
          "model": "muse-wonder-full-1.0",
          "effort": "medium"
        },
        "escalation": {
          "model": "muse-wonder-full-1.0",
          "effort": "high"
        }
      }
    },
    "openai": {
      "executable": "codex",
      "model": "gpt-6.1-sol",
      "effort": "medium",
      "windows_sandbox": "mxc",
      "orchestration_windows_sandbox": "unelevated",
      "orchestration_writable_roots": [],
      "timeout_seconds": 3600,
      "termination_grace_seconds": 120,
      "heartbeat_seconds": 60
    }
  },
  "capabilities": {
    "jev": {
      "enabled": true,
      "authorization_mode": "all_workspaces",
      "allowed_roots": [],
      "model": "jev-1.13.0",
      "timeout_seconds": 10,
      "deadline_seconds": 30,
      "max_requests": 8,
      "max_input_tokens": 120000,
      "max_candidates": 96,
      "max_output_chars": 12000,
      "cache_ttl_seconds": 604800
    }
  },
  "timeout_seconds": 900,
  "quota_probe_seconds": 3600,
  "lock_timeout_seconds": 30,
  "profiles": {
    "openai-sol": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "effort": "medium"
    },
    "openai-sol-high": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    "openai-luna": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "effort": "medium"
